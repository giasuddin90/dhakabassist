# Copy to `.env` and fill in. Nothing here is read in tests.
# `.env` is gitignored; never commit real credentials.

# -- Core -------------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The canonical origin. Canonical links, Open Graph URLs, llms.txt and the
# payment callback URLs are built from this rather than the request's Host
# header, so a spoofed header cannot redirect a payment or poison a canonical.
# It must match the live domain exactly, including the scheme.
SITE_BASE_URL=http://127.0.0.1:8000

# Needed behind a proxy or on a non-default port, e.g.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dhakabassist.com,https://www.dhakabassist.com

# -- Database ---------------------------------------------------------------

# SQLite by default. Set this to use PostgreSQL (recommended in production).
# DJANGO_DB_URL=postgres://user:password@localhost:5432/dhakabassist

# -- Course material --------------------------------------------------------

# Every upload (videos, audio, worksheets, library files) lands in the media
# folder. It is never served directly; files are streamed only after an
# enrolment check. Defaults to ./media.
# DJANGO_MEDIA_ROOT=/srv/dhakabassist/media

# Set when nginx should do the streaming. Must match an `internal` location
# block; see docs/DEPLOYMENT.md.
# DJANGO_MEDIA_INTERNAL_URL=/_media/

# -- Payments ---------------------------------------------------------------

# "sandbox" completes the checkout locally with no gateway account, so the
# success and failure paths can both be tested. Switch to "sslcommerz" once
# live credentials exist.
PAYMENT_GATEWAY=sandbox

# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_SANDBOX=1

# -- Video ------------------------------------------------------------------

# Leave empty to stream from MEDIA_ROOT instead. With these set,
# playback URLs are signed per request and expire.
# KEY_ID and KEY_PEM are the `id` and `pem` (base64, as returned) from
# POST /accounts/<id>/stream/keys. CUSTOMER_CODE is the <CODE> in
# customer-<CODE>.cloudflarestream.com. Every video must also have
# "Require signed URLs" switched on in Stream, or its UID plays publicly.
# TTL is in seconds; Cloudflare's maximum is 86400 (24 hours).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_KEY_ID=
# CLOUDFLARE_STREAM_KEY_PEM=
# CLOUDFLARE_STREAM_CUSTOMER_CODE=
# CLOUDFLARE_STREAM_TOKEN_TTL=7200

# -- Email ------------------------------------------------------------------

# The default prints emails to the console. New students cannot log in until
# they click the signup confirmation link, so production must really send:
# set RESEND_API_KEY and mail goes out through Resend's HTTP API.
#
# Resend (resend.com): create an API key with "Sending access". The from
# address must be on a domain verified under Domains in the Resend dashboard.
# Until then Resend only delivers to your own Resend login address, from
# onboarding@resend.dev.
# RESEND_API_KEY=re_...
#
# Or any SMTP server instead (leave RESEND_API_KEY empty):
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=1
#
# Seconds to wait for the mail service before giving up.
# DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=DhakaBassist <hello@dhakabassist.com>
