# Copy to `.env` and fill in. Never commit `.env`.
# Values below are for local development; docs/DEPLOYMENT.md has production ones.

# -- Core -------------------------------------------------------------------

# Required when DJANGO_DEBUG=0. Generate with:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# 1 for development. Leave unset or 0 in production (HTTPS, HSTS, secure cookies).
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The live origin, scheme included. Canonical links, emails and payment
# callbacks are built from it, never from the request's Host header.
SITE_BASE_URL=http://127.0.0.1:8000

# -- Database ---------------------------------------------------------------

# Leave DB_NAME empty to use SQLite; set it to use PostgreSQL.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost

# -- Payments ---------------------------------------------------------------

# "sandbox" fakes checkout locally; "sslcommerz" with the credentials below.
PAYMENT_GATEWAY=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# 1 uses SSLCommerz's test servers; 0 takes real money.
SSLCOMMERZ_SANDBOX=1

# -- Video (Cloudflare Stream) ----------------------------------------------

# Empty streams from the media folder instead. KEY_ID and KEY_PEM are `id`
# and `pem` from POST /accounts/<id>/stream/keys; CUSTOMER_CODE is the <CODE>
# in customer-<CODE>.cloudflarestream.com. Turn on "Require signed URLs" for
# every video, or it plays publicly.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# -- Email (Resend) ---------------------------------------------------------

# Empty prints emails to the console. Production needs it: students can't log
# in until they click the signup link. The from address must be on a domain
# verified in Resend.
RESEND_API_KEY=
DJANGO_DEFAULT_FROM_EMAIL=DhakaBassist <hello@dhakabassist.com>
